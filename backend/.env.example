# Copy to backend/.env for local development. Never commit the real .env.

# The Guardian Open Platform key (https://open-platform.theguardian.com/access/)
API_KEY=

# Signs login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If unset, a random key is used and everyone is signed out whenever the server restarts.
JWT_SECRET=
JWT_TTL_HOURS=12

# Omit locally to use ./users.db (SQLite). In production use Postgres, because
# Render's free-tier disk is wiped on every deploy. postgres:// URLs are accepted.
DATABASE_URL=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=https://globe-mocha-eta.vercel.app,http://localhost:5173

# Optional public demo account, created at startup if it doesn't exist
DEMO_USERNAME=test1
DEMO_PASSWORD=1234
DEMO_PREFERENCE=technology

# How long a section's located feed is cached, in seconds
FEED_TTL_SECONDS=900

# Nominatim requires an identifying User-Agent (https://operations.osmfoundation.org/policies/nominatim/)
NOMINATIM_USER_AGENT=news-globe/1.1 (+https://github.com/Advait-MD/Globe)
